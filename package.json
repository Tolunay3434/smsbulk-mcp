{
  "name": "smsbulk-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for the SMSBulk SMS & Email verification API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://smsbulk.net",
  "bin": {
    "smsbulk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
