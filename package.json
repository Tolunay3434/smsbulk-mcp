  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sms",
    "sms-verification",
    "email-verification",
    "smsbulk"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.0"
  }
}
