# SMSBulk MCP server configuration
# Copy this file to ".env" and fill in your own values.
# The ".env" file is git-ignored and must never be committed.

# Required: your personal SMSBulk API key (create one in the SMSBulk dashboard).
SMSBULK_API_KEY=

# Base URL for the SMSBulk public API. Leave as-is unless self-hosting.
SMSBULK_BASE_URL=https://smsbulk.net/api/v1

# Optional: soft spend cap (in USD) per MCP session. Best-effort guard enforced
# client-side by this server. Leave blank or set to 0 to disable.
MAX_SPEND_PER_SESSION=
